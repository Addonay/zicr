#version 450
// Writes a 2x2 storage image: texel (x, y) = (x, y, 1, 1).
layout(local_size_x = 2, local_size_y = 2, local_size_z = 1) in;
layout(set = 1, binding = 3, rgba8) uniform writeonly image2D img;
void main() {
    imageStore(img, ivec2(gl_GlobalInvocationID.xy), vec4(float(gl_GlobalInvocationID.x), float(gl_GlobalInvocationID.y), 1.0, 1.0));
}
